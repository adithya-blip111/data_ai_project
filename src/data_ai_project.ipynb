    "    baseline_df[\"Enrollment_Day\"] = baseline_df[\"Enrollment_Date\"].dt.day\n",
    "\n",
    "    baseline_df = baseline_df.drop(columns=[\"Enrollment_Date\"])\n",
    "\n",
    "# Separate target from predictors\n",
    "y_baseline = baseline_df[\"Completed\"].copy()\n",
