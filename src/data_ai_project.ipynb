    "from skeLCS import eLCS\n",
    "import numpy as np\n",
    "from sklearn.metrics import roc_curve, auc, precision_recall_curve\n",
    "from sklearn.preprocessing import label_binarize\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#Initialize and train model\n",
    "model = eLCS(learning_iterations = 2000,track_accuracy_while_fit=True)\n",
    "trainedModel = model.fit(dataFeatures,dataPhenotypes)\n",
    "\n",
    "probs = trainedModel.predict_proba(dataFeatures)\n",
    "print(probs)\n",
    "y_true = np.asarray(dataPhenotypes).ravel()\n",
    "classes = np.unique(y_true)\n",
    "y_true_binary = label_binarize(y_true, classes=classes)\n",
    "\n",
    "if len(classes) == 2:\n",
    "    y_true_binary = y_true_binary.ravel()\n",
    "    scores = probs[:, 1]\n",
    "\n",
    "    fpr, tpr, _ = roc_curve(y_true_binary, scores)\n",
    "    prec, recall, _ = precision_recall_curve(y_true_binary, scores)\n",
    "else:\n",
    "    fpr, tpr, _ = roc_curve(y_true_binary.ravel(), probs.ravel())\n",
    "    prec, recall, _ = precision_recall_curve(y_true_binary.ravel(), probs.ravel())\n",
    "prec, recall, thresholds = precision_recall_curve(dataPhenotypes, probs[:, 1])\n",
    "\n",
    "print(\"Predict\")\n",
    "print(trainedModel.predict(dataFeatures))\n",
    "print(\"Predict Probabilities\")\n",
    "print(trainedModel.predict_proba(dataFeatures))\n",
    "print(\"cross validation score\")\n",
    "print(trainedModel.score(dataFeatures,dataPhenotypes))\n",
    "\n",
    "print(\"Roc/PRC curves\")\n",
    "plt.plot(fpr,tpr,label=\"ROC\")\n",
    "plt.plot(recall,prec,label=\"PRC\")\n",
    "plt.xlabel('False Positive Rate/Recall')\n",
    "plt.ylabel('True Positive Rate/Precision')\n",
    "plt.legend()\n",
    "plt.show()\n",
    "print(\"PRC AUC:\" + str(auc(recall, prec)))\n",
    "print(\"ROC AUC:\" + str(auc(fpr, tpr)))\n",
    "\n",
    "print(\"Final Training Accuracy: \"+str(trainedModel.get_final_accuracy()))\n",
    "print(\"Final Instance Coverage: \"+str(trainedModel.get_final_instance_coverage()))\n",
    "print(\"Final Attribute Specificity List: \"+str(trainedModel.get_final_attribute_specificity_list()))\n",
    "print(\"Final Attribute Accuracy List: \"+str(trainedModel.get_final_attribute_accuracy_list()))\n",
    "\n"
   ]
  }
