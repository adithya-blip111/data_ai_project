    "def clean_data(data):\n",
    "    # Create a copy so the raw dataset stays unchanged\n",
    "    clean = data.copy(deep=True)\n",
    "\n",
    "    # Convert Enrollment_Date to a proper datetime type\n",
    "    clean[\"Enrollment_Date\"] = pd.to_datetime(\n",
    "        clean[\"Enrollment_Date\"], dayfirst=True, errors=\"raise\"\n",
    "    )\n",
    "\n",
    "    # Fill median values for missing values in numerical columns\n",
    "    for col in [\n",
    "        \"Instructor_Rating\",\n",
    "        \"Time_Spent_Hours\",\n",
    "        \"Peer_Interaction_Score\",\n",
    "        \"Quiz_Score_Avg\",\n",
    "        \"Project_Grade\",\n",
    "        \"Progress_Percentage\",\n",
    "        \"App_Usage_Percentage\",\n",
    "        \"Satisfaction_Rating\",\n",
    "    ]:\n",
    "        clean[col] = clean[col].fillna(clean[col].median())\n",
    "\n",
    "    # Convert Enrollment_Date from text to a proper datetime data type\n",
    "    clean[\"Enrollment_Date\"] = pd.to_datetime(clean[\"Enrollment_Date\"], dayfirst=True)\n",
    "\n",
    "    # Remove completely identical duplicate rows, if any\n",
    "    clean = clean.drop_duplicates()\n",
    "\n",
    "    # Create completion-status column used by later graphs\n",
    "    clean[\"Completed_Status\"] = (clean[\"Completed\"] == \"Completed\").astype(bool)\n",
    "\n",
    "    # Reset the row numbers\n",
    "    clean = clean.reset_index(drop=True)\n",
    "\n",
    "    return clean"
   ]
